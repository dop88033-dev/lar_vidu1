# Render Environment Variables Configuration Example
APP_NAME=Laravel
APP_ENV=production
APP_KEY=base64:GENERATE_AND_PASTE_YOUR_KEY_HERE
APP_DEBUG=false
APP_URL=https://lar-vidu1-37mn.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=your-aiven-db-host.aivencloud.com
DB_PORT=25060
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password
MYSQL_ATTR_SSL_CA=/etc/secrets/ca.pem

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
RUN_MIGRATIONS=true
RUN_SEEDERS=false
GHN_WEBHOOK_SECRET=generate-a-long-random-secret

MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=your_momo_test_partner_code
MOMO_ACCESS_KEY=your_momo_test_access_key
MOMO_SECRET_KEY=your_momo_test_secret_key
MOMO_REQUEST_TYPE=payWithMethod
MOMO_VERIFY_SSL=true
MOMO_REDIRECT_URL=https://lar-vidu1-37mn.onrender.com/payment/momo/callback
MOMO_IPN_URL=https://lar-vidu1-37mn.onrender.com/payment/momo/ipn