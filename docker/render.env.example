# Render Environment Variables Configuration Example
APP_NAME=Laravel
APP_ENV=production
APP_KEY=base64:GENERATE_AND_PASTE_YOUR_KEY_HERE
APP_DEBUG=false
APP_URL=https://your-app-name.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=your-aiven-db-host.aivencloud.com
DB_PORT=25060
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password
MYSQL_ATTR_SSL_CA=/etc/secrets/ca.pem

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
RUN_MIGRATIONS=true
RUN_SEEDERS=false
